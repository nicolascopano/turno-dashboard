# Copia este archivo como ".env" y completa los valores.
# Si dejas YOUTUBE_API_KEY vacío, el dashboard muestra datos de DEMO.

YOUTUBE_API_KEY=
YOUTUBE_HANDLE=turnoenvivo

# Instagram (Paso 3, más adelante)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# Zona horaria para "hoy" (ej: America/Santiago, America/Argentina/Buenos_Aires)
TIMEZONE=America/Santiago

# Meta diaria de publicaciones (para el semáforo)
DAILY_GOAL=5
